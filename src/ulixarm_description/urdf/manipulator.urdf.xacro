<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="manipulator_macro" params="prefix">

        <!-- CONSTANTS -->

        <xacro:property name="PI" value="3.14159265359"/>
        <xacro:property name="velocity_limit_DM4340"   value="8.0"/>
        <xacro:property name="effort_limit_DM4340"  value="27.0"/>
        <xacro:property name="velocity_limit_DM4310"   value="30.0"/>
        <xacro:property name="effort_limit_DM4310"  value="10.0"/>

        <!-- LINKS -->
        
        <link name="${prefix}base_link">
            <visual>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/visual/base_link.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/collision/base_link.stl"/>
                </geometry>
            </collision>
        </link>

        <link name="${prefix}link1">
            <visual>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/visual/link1.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/collision/link1.stl"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0. 0.002 0.043"/>
                <mass value="0.575"/>
                <inertia ixx="0.000434" ixy="0.0" ixz="0.0" iyy="0.000387" iyz="0.0" izz="0.000326"/>
            </inertial>
        </link>

        <link name="${prefix}link2">
            <visual>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/visual/link2.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/collision/link2.stl"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.207 0. -0.005"/>
                <mass value="0.887"/>
                <inertia ixx="0.000679" ixy="0.0" ixz="0.001200" iyy="0.010762" iyz="0.0" izz="0.010534"/>
            </inertial>
        </link>

        <link name="${prefix}link3">
            <visual>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/visual/link3.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/collision/link3.stl"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.202 0. -0.004"/>
                <mass value="0.819"/>
                <inertia ixx="0.000572" ixy="0.0" ixz="0.001045" iyy="0.010133" iyz="0.0" izz="0.009994"/>
            </inertial>
        </link>

        <link name="${prefix}link4">
            <visual>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/visual/link4.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/collision/link4.stl"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.024 -0.017 0.048"/>
                <mass value="0.072"/>
                <inertia ixx="0.000075" ixy="0.0" ixz="0.0" iyy="0.000084" iyz="0.0" izz="0.000095"/>
            </inertial>
        </link>

        <link name="${prefix}link5">
            <visual>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/visual/link5.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/collision/link5.stl"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.028 0. -0.027"/>
                <mass value="0.786"/>
                <inertia ixx="0.000379" ixy="0.0" ixz="0.0" iyy="0.001085" iyz="0.0" izz="0.001097"/>
            </inertial>
        </link>

        <link name="${prefix}link6">
            <visual>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/visual/link6.dae"/>
                </geometry>
            </visual>
            <inertial>
                <origin xyz="0. 0. 0.007"/>
                <mass value="0.025"/>
                <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
            </inertial>
        </link>

        <link name="${prefix}tool0">
            <inertial>
                <origin xyz="0. 0. 0."/>
                <mass value="0.001"/>
                <inertia ixx="0.000004" ixy="0.0" ixz="0.0" iyy="0.000003" iyz="0.0" izz="0.000006"/>
            </inertial>
        </link>


        <!-- JOINTS -->

        <joint name="joint1" type="revolute">
            <origin xyz="0. 0. 0.0645" rpy="0. 0. 0."/>
            <parent link="${prefix}base_link"/>
            <child link="${prefix}link1"/>
            <axis xyz="0 0 1"/>
            <limit lower="-1.8326" upper="1.8326" velocity="${velocity_limit_DM4340}" effort="${effort_limit_DM4340}"/> 
        </joint>

        <joint name="joint2" type="revolute">
            <origin xyz="0. -0.031175 0.0495" rpy="${PI/2} ${-PI/2} 0."/>
            <parent link="${prefix}link1"/>
            <child link="${prefix}link2"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-PI/2}" upper="1.25664" velocity="${velocity_limit_DM4340}" effort="${effort_limit_DM4340}"/> 
        </joint>

        <joint name="joint3" type="revolute">
            <origin xyz="0.280 0. -0.0523" rpy="0. ${PI} ${PI}"/>
            <parent link="${prefix}link2"/>
            <child link="${prefix}link3"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-PI/2}" upper="2.82743" velocity="${velocity_limit_DM4340}" effort="${effort_limit_DM4340}"/> 
        </joint>

        <joint name="joint4" type="revolute">
            <origin xyz="0.280 0. -0.046" rpy="0. ${PI} ${PI}"/>
            <parent link="${prefix}link3"/>
            <child link="${prefix}link4"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-PI/2}" upper="2.61799" velocity="${velocity_limit_DM4310}" effort="${effort_limit_DM4310}"/> 
        </joint>

        <joint name="joint5" type="revolute">
            <origin xyz="0.052 -0.036 -0.034" rpy="${PI/2} 0. ${-PI/2}"/>
            <parent link="${prefix}link4"/>
            <child link="${prefix}link5"/>
            <axis xyz="0 0 -1"/>
            <limit lower="-1.8326" upper="1.8326" velocity="${velocity_limit_DM4310}" effort="${effort_limit_DM4310}"/> 
        </joint>

        <joint name="joint6" type="revolute">
            <origin xyz="0.0855 0. -0.0265" rpy="${PI} ${-PI/2} 0."/>
            <parent link="${prefix}link5"/>
            <child link="${prefix}link6"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.93215" upper="2.93215" velocity="${velocity_limit_DM4310}" effort="${effort_limit_DM4310}"/> 
        </joint>

        <joint name="joint_tool0" type="fixed">
            <origin xyz="0. 0. 0.005" rpy="0. 0. 0."/>
            <parent link="${prefix}link6"/>
            <child link="${prefix}tool0"/>
        </joint>

    </xacro:macro>

</robot>
