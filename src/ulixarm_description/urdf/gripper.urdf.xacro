<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="gripper_macro" params="prefix">
        
        <!-- CONSTANTS -->

        <xacro:property name="PI" value="3.14159265359"/>

        <!-- LINKS -->
        
        <link name="${prefix}base_link">
            <visual>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/visual/gripper.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/collision/gripper.stl"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="-0.012 0. 0.036"/>
                <mass value="0.73"/>
                <inertia ixx="0.000939" ixy="0.0" ixz="0.0" iyy="0.000987" iyz="0.0" izz="0.001086"/>
            </inertial>
        </link>

        <link name="${prefix}finger_right">
            <visual>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/visual/finger.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/collision/finger.stl"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.010 0.002 -0.040"/>
                <mass value="0.0"/>
                <inertia ixx="0.000034" ixy="0.0" ixz="0.0" iyy="0.000048" iyz="0.0" izz="0.000026"/>
            </inertial>
        </link>

        <link name="${prefix}finger_left">
            <visual>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/visual/finger.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://ulixarm_description/meshes/collision/finger.stl"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.010 0.002 -0.040"/>
                <mass value="0.0"/>
                <inertia ixx="0.000034" ixy="0.0" ixz="0.0" iyy="0.000048" iyz="0.0" izz="0.000026"/>
            </inertial>
        </link>


        <!-- JOINTS -->

        <joint name="finger_right_joint" type="prismatic">
            <origin xyz="0. 0. 0.0745" rpy="0. 0. ${PI/2}"/>
            <parent link="${prefix}base_link"/>
            <child link="${prefix}finger_right"/>
            <axis xyz="1 0 0"/>
            <limit lower="0.0" upper="0.045" velocity="0.5" effort="10.0"/> 
        </joint>

        <joint name="finger_left_joint" type="prismatic">
            <origin xyz="0. 0. 0.0745" rpy="0. 0. ${-PI/2}"/>
            <parent link="${prefix}base_link"/>
            <child link="${prefix}finger_left"/>
            <axis xyz="1 0 0"/>
            <mimic joint="finger_right_joint" multiplier="1" offset="0"/>
            <limit lower="0.0" upper="0.045" velocity="0.5" effort="10.0"/> 
        </joint>

  </xacro:macro>

</robot>
